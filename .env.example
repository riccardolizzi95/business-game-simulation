# ============================================================================
# Business Game — variabili d'ambiente (ESEMPIO — nessun valore reale qui)
# ============================================================================
# Questo file NON va compilato con segreti veri: serve solo da riferimento.
# I valori reali vivono SOLO in:
#   - locale       → apps/web/.env.local        (ignorato da .gitignore, mai committato)
#   - Vercel       → Project Settings → Environment Variables (per env: Development/Preview/Production)
#   - GitHub Actions → Settings → Secrets and variables → Actions
#   - Supabase     → Project Settings → Edge Functions → Secrets (per le funzioni schedulate)
#
# Guida completa e passi di attivazione: docs/09-piattaforma-hosting.md
# ============================================================================


# ---- PWA (Next.js su Vercel) — connessione a Supabase -----------------------

# URL pubblico del progetto Supabase. Non è un segreto.
# Da: Supabase Dashboard → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Chiave "anon" pubblica di Supabase. Esposta al client di proposito: l'accesso
# ai dati resta comunque vincolato dalle policy di Row Level Security.
# Da: Supabase Dashboard → Project Settings → API → Project API keys → anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pubblico dell'app, usato per i redirect dell'OAuth Google e nei link email.
# Dev:  http://localhost:3000
# Prod: https://<dominio-vercel-o-custom>
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# ---- Solo server (Route Handler / Server Action Next.js) --------------------
# MAI con prefisso NEXT_PUBLIC_, MAI importate in codice che finisce nel bundle
# client. Bypassano la Row Level Security: usarle solo dove indispensabile.

# Chiave "service_role" di Supabase.
# Da: Supabase Dashboard → Project Settings → API → Project API keys → service_role
SUPABASE_SERVICE_ROLE_KEY=

# Segreto condiviso per autenticare le chiamate al tick trimestrale (vedi sotto).
# Generare con: openssl rand -hex 32
TICK_CRON_SECRET=


# ---- Supabase CLI (solo uso locale/CI per migrazioni, mai nel client) -------

# Riferimento del progetto, per `supabase link --project-ref <valore>`.
# Da: Supabase Dashboard → Project Settings → General → Reference ID
SUPABASE_PROJECT_REF=

# Personal access token per operazioni CLI non interattive (es. CI di migrazione).
# Da generare in: https://supabase.com/dashboard/account/tokens
# Da NON confondere con le chiavi del progetto sopra: questo token ha accesso
# a livello di account Supabase, va trattato con la massima cautela.
SUPABASE_ACCESS_TOKEN=


# ---- Orchestratore autonomo degli agenti (facoltativo) ----------------------
# Vedi orchestrator/README.md per l'elenco completo dei provider LLM supportati
# e per come l'orchestratore legge queste chiavi (mai lette da file, solo da env).
# Non necessario per il deploy della PWA: riguarda solo chi esegue il team di
# agenti in locale o via GitHub Actions.
#
# NVIDIA_API_KEY=nvapi-...
# OPENROUTER_API_KEY=
